generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String          @id @default(cuid())
  username           String          @unique
  passwordHash       String
  xp                 Int             @default(0)
  featherBalance     Int             @default(0)
  level              Int             @default(1)
  civilityScore      Float           @default(0)
  currentStreak      Int             @default(0)
  longestStreak      Int             @default(0)
  lastActiveDate     DateTime?
  equippedCosmetics  Json?
  surveyResponses    Json?
  onboardingCompletedAt DateTime?
  createdAt          DateTime        @default(now())
  debates            Debate[]
  badges             UserBadge[]
  inventory          UserInventory[]
  skillSessions      SkillSession[]
  turkeys            Turkey[]
  // Columns from another prototype sharing this DB — kept so db push never drops them. Unused by this branch.
  companionHatchedAt DateTime?
  companionSpecies   String?
  lastTopicId        String?
  learnedMoves       Json?
}

model UserInventory {
  id          String   @id @default(cuid())
  userId      String
  itemId      String
  purchasedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
}

model Debate {
  id           String    @id @default(cuid())
  userId       String
  topic        String
  category     String    @default("General")
  beliefKey    String    @default("lean-right")
  difficulty   String    @default("Friendly")
  personaId    String?
  overallScore Float?
  xpEarned     Int       @default(0)
  feathersEarned Int     @default(0)
  isDaily          Boolean   @default(false)
  completed        Boolean   @default(false)
  newsStoryUrl     String?
  newsStoryContent String?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?
  isTraining          Boolean  @default(false)
  systemPrompt        String?
  trainingMode        String?
  trainingSkillScores Json?
  mode         String    @default("text")
  // Columns from another prototype sharing this DB — kept so db push never drops them. Unused by this branch.
  dimensions   Json?
  userStance   String?
  /// Opt-in from the setup screen; only honored for Full Gobble debates.
  allowProfanity Boolean @default(false)
  analysis     Json?
  user         User      @relation(fields: [userId], references: [id])
  messages     Message[]
  personaRatings PersonaRating[] // No longer written (rating UI removed); drop with the model below.
}

model Message {
  id             String   @id @default(cuid())
  debateId       String
  role           String
  content        String
  civilityScore  Float?
  dimensions     String?
  // Columns from another prototype sharing this DB — kept so db push never drops them. Unused by this branch.
  moveId         String?
  createdAt      DateTime @default(now())
  debate         Debate   @relation(fields: [debateId], references: [id])
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeKey String
  earnedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id])

  @@unique([userId, badgeKey])
}

model SkillSession {
  id               String    @id @default(cuid())
  userId           String
  skillKey         String
  stage            String    @default("storyline")
  variant          String    @default("standard")
  stepResponses    Json?
  preStressRating  Int?
  postStressRating Int?
  preDebateId      String?
  postDebateId     String?
  preCivility      Float?
  postCivility     Float?
  prePostText      String?
  postPostText     String?
  statement1       String?
  statement2       String?
  feathersEarned   Int?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id])
}

// Unused since the difficulty-rating card was removed. Kept because the Vercel build runs
// `prisma db push`, which refuses to drop a table holding rows. Drop by hand with
// --accept-data-loss when convenient, together with Debate.personaRatings.
model PersonaRating {
  id         String   @id @default(cuid())
  userId     String
  debateId   String
  personaId  String
  rating     Int
  createdAt  DateTime @default(now())
  debate     Debate   @relation(fields: [debateId], references: [id])

  @@unique([userId, debateId])
}

model Turkey {
  id            String           @id @default(cuid())
  userId        String
  skill         String           // a TurkeySkillKey from src/lib/flock/skills.ts
  name          String?          // null until hatched
  hatchedAt     DateTime?        // null = still an egg
  activityCount Int              @default(0)
  lastFedAt     DateTime?        // hunger
  lastSocialAt  DateTime?        // loneliness
  lastTaughtAt  DateTime?        // sadness
  equippedCosmetics Json?        // this turkey's outfit, slot -> shop item id (items are owned by the user)
  createdAt     DateTime         @default(now())
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities    TurkeyActivity[]

  @@unique([userId, skill])
}

model TurkeyActivity {
  id          String    @id @default(cuid())
  turkeyId    String
  kind        String    // "park" | "feed" | "school"
  refId       String?   @unique // Debate.id (park) or SkillSession.id (feed); null for school
  score       Float?    // 0-10 civility snapshot for the skill trend
  feathers    Int       @default(0)
  counted     Boolean   @default(false) // true when it refilled a need and counted toward growth
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  turkey      Turkey    @relation(fields: [turkeyId], references: [id], onDelete: Cascade)

  @@index([turkeyId, completedAt])
}
