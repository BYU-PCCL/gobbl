# Copy this file to .env.local and fill in the values.

# Neon Postgres connection string (append ?sslmode=require if needed)
DATABASE_URL=

# NextAuth: a random 32+ character secret, and the site URL (http://localhost:3000 locally)
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# xAI Grok API key (xai-...). Without it, the AI partner won't reply.
GROK_API_KEY=

# Optional model overrides. Uncomment only if setting a value; a blank value breaks the AI.
# Defaults: grok-4-1-fast-reasoning and grok-3-fast.
# GROK_MODEL=
# GROK_CIVILITY_MODEL=
