# Copy this file to .env.local and fill in the values.

# Supabase Postgres (Dashboard → Connect → ORMs → Prisma).
# DATABASE_URL: transaction pooler, port 6543, ending in ?pgbouncer=true (used by the app).
# DIRECT_URL: session pooler, port 5432 (used by `prisma db push`).
DATABASE_URL=
DIRECT_URL=

# NextAuth: a random 32+ character secret, and the site URL (http://localhost:3000 locally)
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# xAI Grok API key (xai-...). Without it, the AI partner won't reply.
GROK_API_KEY=

# Optional model overrides. Uncomment only if setting a value; a blank value breaks the AI.
# Default for both: grok-4.20-0309-non-reasoning. Use a full model id, not an alias —
# retired aliases silently resolve to a slower reasoning model.
# GROK_MODEL=
# GROK_CIVILITY_MODEL=
