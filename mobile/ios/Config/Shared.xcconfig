// Settings shared by every configuration. Debug.xcconfig / Release.xcconfig include this file.
PRODUCT_NAME = Gobbl
PRODUCT_BUNDLE_IDENTIFIER = com.CHANGE-ME.gobbl   // TODO: set to the team's reverse-DNS bundle ID before archiving
IPHONEOS_DEPLOYMENT_TARGET = 17.0
TARGETED_DEVICE_FAMILY = 1                          // iPhone only for v1
SWIFT_VERSION = 5.0                                 // language mode (Xcode accepts 4, 4.2, 5, 6 only); the toolchain is Swift 5.10+/6.x
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

// Info.plist: Gobbl/Info.plist is preprocessed so Debug-only keys can live under #if GOBBL_DEBUG.
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = Gobbl/Info.plist
INFOPLIST_PREPROCESS = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait
INFOPLIST_KEY_ITSAppUsesNonExemptEncryption = NO    // standard HTTPS only — skips the export-compliance prompt on upload
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents = YES
